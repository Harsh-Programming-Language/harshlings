// patterns02
//
// `let … else:` takes a value apart or leaves the function. The `else:`
// block must leave — return, break, continue or panic — and this one
// tries to produce a value instead.
//
// Run `hrs run -- hint patterns02` for a hint.

// I AM NOT DONE

fn first_digit s: &str -> Option<u32>:
    let Some c = s <- chars$ <- next$ else:
        None
    c <- to_digit 10

fn main$:
    println! "{:?} {:?}" (first_digit "7up") (first_digit "")
