// functions02
//
// An argument that is more than one token — an expression — is one argument
// once it is in parentheses. This call is meant to double `n + 1`. Make it
// say so.
//
// Run `hrs run -- hint functions02` for a hint.

// I AM NOT DONE

fn double x: i32 -> i32:
    x * 2

fn main$:
    let n = 4
    let d = double n + 1
    assert_eq! d 10
    println! "{d}"
