// macros04
//
// Calling a macro uses the same block kit as everything else: `\` when the
// entries are comma-separated, `do:` when they are statements. This call
// hands `pair!` two statements where it wants two values.
//
// Run `hrs run -- hint macros04` for a hint.

// I AM NOT DONE

macro_rules! pair {
    ( $a:expr, $b:expr ) => { ($a, $b) };
}

fn main$:
    let p = pair! do:
        1
        2
    assert_eq! p (1, 2)
    println! "{p:?}"
