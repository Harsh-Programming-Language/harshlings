// threads01
//
// A spawned thread may outlive the function that started it, so it
// cannot borrow `v`. Move `v` in, and wait for the thread.
//
// Run `hrs run -- hint threads01` for a hint.

// I AM NOT DONE

use std.thread

fn main$:
    let v = vec! [1, 2, 3]
    let handle = thread.spawn (|| println! "{v:?}")
    handle <- join$ <- unwrap$
