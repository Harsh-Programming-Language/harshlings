// threads02
//
// A channel: one end sends, the other receives. The sender is moved into
// the thread; the main thread waits for the value.
//
// Run `hrs run -- hint threads02` for a hint.

// I AM NOT DONE

use std.sync.mpsc
use std.thread

fn main$:
    let (tx, rx) = mpsc.channel$
    thread.spawn (move || tx <- send 42 <- unwrap$)
    let got: i32 = rx
    assert_eq! got 42
    println! "{got}"
