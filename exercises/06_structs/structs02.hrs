// structs02
//
// A method lives in an `impl` block and takes `&self`. Write `area` so the
// assertion holds.
//
// Run `hrs run -- hint structs02` for a hint.

// I AM NOT DONE

struct Rect
    w: u32
    h: u32

impl Rect
    fn area (&self) -> u32:
        0

fn main$:
    let r = Rect\ w = 3, h = 4
    assert_eq! (r <- area$) 12
    println! "{}" (r <- area$)
