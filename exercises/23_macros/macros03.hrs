// macros03 — not a macro: `extern` blocks, taught beside macros in the
// Book's chapter on advanced features
//
// An `extern` block is a block: `extern "C":` with each foreign signature
// on its own line and no body. This one wears braces on several lines.
//
// Run `hrs run -- hint macros03` for a hint.

// I AM NOT DONE

extern "C" {
    fn abs(x: i32) -> i32;
}

fn main$:
    let n = unsafe: abs (-7)
    println! "{n}"
