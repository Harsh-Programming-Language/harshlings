// matrices07
//
// `f<>` applies a function to each element of a matrix. It is a mark, written
// tight against the function, as `$` is: `f$` applies `f` to nothing, `f<>`
// applies it to each. It borrows the matrix, and it pipes. `half` takes one
// number; the compiler says what it was given instead.
//
// Run `hrs run -- hint matrices07` for a hint.

// I AM NOT DONE

fn half (x: f64) -> f64:
    x / 2.0

fn main$:
    let a = m~ [2.0 4.0; 6.0 8.0]
    let halved = half a
    assert_eq! halved (m~ [1.0 2.0; 3.0 4.0])
    println! "{}" (a |> half<> |> f64.sqrt<>)
