// matrices05
//
// A part of a matrix. `a <- slice (0..2) (..)` copies rows 0 and 1 and every
// column; `&a[0..2, ..]` borrows the same part, as a view. Ranges count from
// 0 and leave their end out, as everywhere in Harsh, and `..` alone means all
// of it. The bottom-right corner is wanted here: the last two rows, the last
// two columns.
//
// Run `hrs run -- hint matrices05` for a hint.

// I AM NOT DONE

fn main$:
    let a = m~ [1 2 3; 4 5 6; 7 8 9]
    let corner = a <- slice (0..2) (0..2)
    assert_eq! corner (m~ [5 6; 8 9])
    println! "{}" (&a[1.., 1..])
