// comprehensions03
//
// Several `for`s nest, and each `if` belongs to the `for` before it, so it
// can use every name bound so far. List the pairs (x, y) from 1 to 3 where
// y is strictly greater than x.
//
// Run `hrs run -- hint comprehensions03` for a hint.

// I AM NOT DONE

fn main$:
    let pairs = list~ (x, y) for x in 1..4 for y in 1..4
    assert_eq! pairs (vec! (1, 2) (1, 3) (2, 3))
    println! "{pairs:?}"
